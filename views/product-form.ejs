<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Products Form</title>
</head>
<body>
  <h1>Add a New Product</h1>
  <form action="<%= product ? '/update-product/' + product.id : '/add-product' %>" method="POST">
    <label for="name">Product Name:</label>
    <input type="text" id="name" name="name" value="<%= product ? product.name : '' %>" required>
    <br>
    <label for="description">Product Description:</label>
    <textarea id="description" name="description"><%= product ? product.description : '' %></textarea>
    <br>
    <label for="category">Product Category:</label>
    <input type="text" id="category" name="category" value="<%= product ? product.category : '' %>" required>
    <br>
    <label for="price">Product Price:</label>
    <input type="number" id="price" name="price" value="<%= product ? product.price : '' %>" required>
    <br>
    <button type="submit"><%= product ? 'Update Product' : 'Add Product' %></button>
  </form><br>
  <a href="/">Go Back to Home</a>
</body>
</html>