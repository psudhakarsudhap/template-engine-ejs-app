<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Products</title>
</head>
<body>
  <h1>Products CRUD</h1>
  <a href="/product-form">Add a New Product</a>
  <br><br>
  <div style="display: flex; flex-wrap: wrap; gap: 10px;"> 
  <% products.forEach(product => { %>
    <div style="border: 1px solid #000; padding: 10px; margin: 10px;
    width: 220px; border-radius: 5px; box-shadow: 0px 4px 8px rgba(0,0,0,0.5);">
      <p>Product Name: <%= product.name %></p>
      <p>Product Category: <%= product.category %></p>
      <p>Product Price: Rs: <%= product.price %></p>
      <p><a href="/product/<%= product.id %>">View</a> |
        <a href="/product-form/<%= product.id %>">Edit</a> | <a href="/delete-product/<%= product.id %>">Delete</a></p>
    </div>
  <% }); %>
  </div>
</body>
</html>